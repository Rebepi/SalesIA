{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SalesIA Enterprise Domain Events Catalog",
  "version": "1.0.0",
  "definitions": {
    "SaleCreatedEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string", "enum": ["sale.created"] },
        "company_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "sale_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "format": "uuid" },
        "total_amount": { "type": "string" },
        "currency": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" }
      },
      "required": ["event_id", "event_type", "company_id", "branch_id", "sale_id", "total_amount", "currency", "occurred_at"]
    },
    "SaleConfirmedEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string", "enum": ["sale.confirmed"] },
        "company_id": { "type": "string", "format": "uuid" },
        "sale_id": { "type": "string", "format": "uuid" },
        "items_count": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" }
      },
      "required": ["event_id", "event_type", "company_id", "sale_id", "items_count", "occurred_at"]
    },
    "PaymentReceivedEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_type": { "type": "string", "enum": ["payment.received"] },
        "company_id": { "type": "string", "format": "uuid" },
        "payment_id": { "type": "string", "format": "uuid" },
        "sale_id": { "type": "string", "format": "uuid" },
        "amount": { "type": "string" },
        "currency": { "type": "string" },
        "payment_method": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" }
      },
      "required": ["event_id", "event_type", "company_id", "payment_id", "sale_id", "amount", "currency", "payment_method", "occurred_at"]
    }
  }
}
